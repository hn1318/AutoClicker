{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClicker",
  "version": "0.1.0",
  "identifier": "top.hn3.autoclicker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoClicker",
        "width": 460,
        "height": 640,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
